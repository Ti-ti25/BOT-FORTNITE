# Copie ce fichier en ".env" et remplis les vraies valeurs.
# Ne partage JAMAIS ton fichier .env (ajoute-le à .gitignore si tu utilises Git).

# Token du bot (Discord Developer Portal > ton appli > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Discord Developer Portal > ton appli > General Information > Application ID)
CLIENT_ID=

# ID du salon où poster les récaps automatiques
CHANNEL_ID=1551948254298513480

# Optionnel : ID de ton serveur, pour que la commande /competitions
# apparaisse instantanément pendant les tests (sinon ça peut prendre 1h
# en global). Laisse vide pour un déploiement global.
GUILD_ID=

# Ton ID Discord (clic droit sur ton pseudo > Copier l'ID, mode développeur activé).
# Seule cette personne pourra utiliser /ajouter, /supprimer et /sync.
ADMIN_ID=

# Obligatoire pour la synchro Liquipedia : identifie ton projet + un contact,
# exigé par les conditions d'utilisation de leur API (sinon blocage).
# Exemple : "MonBotFortnite/1.0 (discord: tonpseudo)"
LIQUIPEDIA_USER_AGENT=
